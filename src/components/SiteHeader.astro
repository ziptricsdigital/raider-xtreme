---
/** Prospective-customer journey. Mobile menu uses native <details> — no JS. */
import { primaryNav, links, ext } from '../data/site';
const { current = '/' } = Astro.props as { current?: string };
const isActive = (href: string) => href !== '/' && current.startsWith(href);
---
<header class="sticky top-0 z-40 border-b border-black/5 bg-white/95 backdrop-blur">
  <nav aria-label="Primary" class="relative mx-auto grid max-w-site grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-x-7 px-6 py-3">
    <a href="/" aria-label="Raider Xtreme home" class="flex items-center gap-3">
      <img src="/images/raider-x-logo.png" alt="Raider Xtreme logo: a red and black X with the word Raider in script" width="56" height="45" class="h-11 w-auto" />
      <span class="hidden font-display text-2xl font-extrabold uppercase leading-none tracking-tight sm:inline">Raider <span class="text-scarlet">Xtreme</span></span>
    </a>
    <!-- DECAP CMS: settings.primaryNav loop -->
    <ul class="hidden justify-end gap-6 text-[15px] font-semibold md:flex">
      {primaryNav.map((n) => n.children ? (
        <li class="relative">
          <details class="group" data-nav-menu>
            <summary class:list={['flex cursor-pointer list-none items-center gap-1.5 hover:text-scarlet', n.children.some((c) => !c.external && isActive(c.href.split('#')[0])) && 'text-scarlet']}>{n.label} <span class="text-[10px]" aria-hidden="true">▾</span></summary>
            <ul class="absolute left-0 top-full mt-2.5 w-52 rounded-lg bg-white p-2 shadow-xl ring-1 ring-black/5">
              {n.children.map((c) => <li><a href={c.href} {...(c.external ? ext : {})} class="block rounded px-3 py-2.5 hover:bg-bone hover:text-scarlet">{c.label}</a></li>)}
            </ul>
          </details>
        </li>
      ) : (
        <li><a href={n.href} aria-label={n.label} aria-current={isActive(n.href) ? 'page' : undefined}
               class:list={['hover:text-scarlet', isActive(n.href) && 'text-scarlet']}>{n.label}</a></li>
      ))}
    </ul>
    <details class="justify-self-end md:hidden" data-nav-menu>
      <summary aria-label="Open menu" class="cursor-pointer list-none rounded border border-black/15 px-3 py-2 text-sm font-bold uppercase">Menu</summary>
      <div class="absolute inset-x-4 top-full mt-2 max-h-[calc(100vh-8rem)] overflow-y-auto rounded-lg bg-white p-2 shadow-xl ring-1 ring-black/5">
        {primaryNav.map((n) => n.children ? (
          <details class="group border-b border-black/5 last:border-0">
            <summary class="flex cursor-pointer list-none items-center justify-between rounded px-3 py-3 font-bold hover:bg-bone">{n.label}<span aria-hidden="true" class="mr-1 h-2 w-2 -translate-y-0.5 rotate-45 border-b-2 border-r-2 border-current transition group-open:translate-y-0.5 group-open:-rotate-[135deg]"></span></summary>
            <ul class="pb-2 pl-3">
              {n.children.map((c) => <li><a href={c.href} {...(c.external ? ext : {})} class="block rounded px-3 py-2.5 text-[15px] text-ink-muted hover:bg-bone hover:text-scarlet">{c.label}</a></li>)}
            </ul>
          </details>
        ) : (
          <a href={n.href} class="block rounded px-3 py-3 font-bold hover:bg-bone">{n.label}</a>
        ))}
      </div>
    </details>
    <a href={links.enrollClasses} {...ext} aria-label="Enroll in a class online (opens iClassPro in a new tab)"
       class="whitespace-nowrap rounded bg-scarlet px-5 py-2.5 text-sm font-bold uppercase tracking-wide text-white transition hover:bg-scarlet-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-scarlet">Enroll Now</a>
  </nav>
</header>
<script is:inline>
  // close any open dropdown on outside click / Escape
  document.addEventListener('click', (e) => document.querySelectorAll('details[data-nav-menu][open]').forEach((d) => { if (!d.contains(e.target)) d.removeAttribute('open'); }));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && document.querySelectorAll('details[data-nav-menu][open]').forEach((d) => d.removeAttribute('open')));
</script>
