---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FactStrip from '../components/FactStrip.astro';
import Section from '../components/Section.astro';
import CtaBand from '../components/CtaBand.astro';
import DiamondList from '../components/DiamondList.astro';
import InfoCard from '../components/InfoCard.astro';
import { site, links } from '../data/site';
const facts = [{ stat: 'Schools', label: 'Classes & grade levels' }, { stat: 'Churches', label: 'Youth & family groups' }, { stat: 'Daycares', label: 'Summer & year-round' }, { stat: 'Supervised', label: 'By Raider Xtreme staff' }];
---
<Base title="Field Trips for Schools, Churches & Daycares in Lubbock | Raider Xtreme" description="Staff-supervised gym field trips in Lubbock with trampolines, tumble track, foam pit, rope swing and an obstacle course inflatable.">
  <PageHero crumbs={[{ label: 'Party & Play', href: '/parties' }, { label: 'Field Trips' }]} kicker="Group outings" title="Field" accent="Trips"
    intro="Supervised, high-energy gym time for school groups, church groups, daycares and more."
    ctas={[{ label: 'Plan a Trip', href: '#contact' }, { label: `Call ${site.phone}`, href: site.phoneHref, variant: 'outline' }]} />
  <FactStrip facts={facts} />
  <Section kicker="Every trip includes" title="Full gym access">
    <div class="grid items-start gap-8 md:grid-cols-2">
      <DiamondList cols={1} items={['Supervised playtime', 'Trampolines', 'Tumble track', 'Rope swing &amp; foam pit', 'Inflatables', 'Xtreme obstacle course inflatable', 'Raider Xtreme staff supervision']} />
      <div role="img" aria-label="Elementary school group in matching field-trip shirts cheering on the Raider Xtreme gym floor" class="aspect-[4/3] w-full rounded-lg flex items-end overflow-hidden p-3 [background:repeating-linear-gradient(135deg,#E6E3DE_0_12px,#EEECE8_12px_24px)]"><span class="max-w-full rounded-sm bg-white px-2 py-1 font-mono text-[11px] uppercase leading-snug text-ink-muted">Elementary school group in matching field-trip shirts cheering on the Raider Xtreme gym floor</span></div>
    </div>
  </Section>
  <CtaBand title="Plan your trip" text="Tell us your group size and preferred dates — we’ll send availability and pricing."
    primary={{ label: 'Send a Request', href: '#contact' }} secondary={{ label: 'Call Us', href: site.phoneHref }} />
</Base>
